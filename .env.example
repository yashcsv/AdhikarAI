# App
APP_NAME=AdhikarAI
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Data
DATA_DIR=./data
CORE_CODE_DIR=./data/core_code
CORE_ACT_DIR=./data/core_act
SUPPORTING_ACT_DIR=./data/supporting_act

# Retrieval/Index
VECTOR_DB_PATH=./data/vectorstore
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5

# LLM
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Email (Gmail OAuth2)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:5678/rest/oauth2-credential/callback
GMAIL_FROM_EMAIL=

# Feature flags (low-resource defaults)
ENABLE_QUERY_REWRITE=false
ENABLE_MULTI_QUERY=false
ENABLE_EVAL_ON_DEMAND=true
ENABLE_UPLOAD=true

# Observability
LOG_LEVEL=INFO
ENABLE_TRACING=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AdhikarAI
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
